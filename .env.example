PORT=8000
MONGODB_URI=
DB_NAME=booknook
ALLOWED_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Enable Better Auth's documented JWT plugin (`jwt()`) on the auth server.
# By default, issuer and audience must match Better Auth's configured baseURL.
# Its default subject is the user ID and default payload is the session user;
# Express requires the resulting `sub`, `name`, and `email` claims on writes.
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=http://localhost:3000
# The JWT plugin JWKS route, including the auth server's mount path.
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
